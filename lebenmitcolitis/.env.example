# lebenmitcolitis.de — API Keys Template
# WICHTIG: Diese Datei als ".env" kopieren und ALLE Keys ausfüllen
# cp .env.example .env
# Die .env Datei ist in .gitignore — nie commiten!

# ─── Claude / Anthropic ─────────────────────────────────────────────────────────
# Holen unter: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google AI (Gemini / Imagen 3 / Veo 2) ──────────────────────────────────────
# Holen unter: aistudio.google.com → Get API Key
GOOGLE_AI_API_KEY=AIza...

# ─── Perplexity (Echtzeit Media Buying Wissen) ───────────────────────────────────
# Holen unter: perplexity.ai/settings/api → Sonar Pro Plan (~$20/Monat)
PERPLEXITY_API_KEY=pplx-...

# ─── Meta Ads API ────────────────────────────────────────────────────────────────
# System User Token aus Meta Business Manager → Business Settings → Users → System Users
# Ad Account ID aus Meta Ads Manager (Format: act_XXXXXXXXX)
META_ACCESS_TOKEN=EAAx...
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# ─── Google Ads API ──────────────────────────────────────────────────────────────
# Developer Token: developers.google.com/google-ads/api/docs/get-started/dev-token
# OAuth Setup: console.cloud.google.com → Google Ads API aktivieren
GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
GOOGLE_ADS_CUSTOMER_ID=xxx-xxx-xxxx
GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxx

# ─── Email (Brevo) ───────────────────────────────────────────────────────────────
# Holen unter: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...

# ─── Telegram Bot (Daily KPI Reports) ────────────────────────────────────────────
# 1. @BotFather auf Telegram → /newbot → Token kopieren
# 2. Chat ID: @userinfobot schreiben → deine Chat ID kopieren
TELEGRAM_BOT_TOKEN=7xxxxxxxxxx:AAH...
TELEGRAM_CHAT_ID=xxxxxxxxxx
