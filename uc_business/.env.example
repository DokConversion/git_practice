# ============================================================
# UC Business System — Umgebungsvariablen
# Kopiere diese Datei: cp .env.example .env
# Trage deine API Keys ein — NIEMALS in Git pushen!
# ============================================================

# ─── Claude / Anthropic ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Ads ───────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=              # Format: 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # MCC-Account (wenn vorhanden)

# ─── Meta / Facebook ──────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=                  # Format: act_XXXXXXXXXX
META_PIXEL_ID=
META_PAGE_ID=

# ─── Email-Marketing ──────────────────────────────────────────
EMAIL_PROVIDER=activecampaign        # activecampaign | mailchimp | getresponse
EMAIL_API_KEY=
EMAIL_API_URL=                       # z.B. https://ACCOUNT.api-us1.com (ActiveCampaign)
EMAIL_FROM_NAME=UC Insider
EMAIL_FROM_ADDRESS=hallo@uc-insider.de

# Automation-IDs (im Email-Tool nachschauen)
EMAIL_WELCOME_AUTOMATION_ID=
EMAIL_UPSELL_AUTOMATION_ID=

# Für Mailchimp:
# MAILCHIMP_LIST_ID=

# Für GetResponse:
# GETRESPONSE_CAMPAIGN_ID=

# ─── Produkt-Plattform ────────────────────────────────────────
PRODUCT_PLATFORM=digistore24         # digistore24 | elopage | teachable
PRODUCT_API_KEY=
PRODUCT_API_SECRET=

# Produkt-IDs (aus deiner Produkt-Plattform)
PRODUCT_ID_LEADMAGNET=
PRODUCT_ID_ENTRY=                    # UC Ernährungs-Kompass
PRODUCT_ID_UPSELL=                   # UC Selbsthilfe-System

# ─── Tracking ─────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=                      # Aus GA4 Admin → Data Streams → Measurement Protocol

# ─── Website ──────────────────────────────────────────────────
WEBSITE_DOMAIN=uc-insider.de

# ─── System ───────────────────────────────────────────────────
DRY_RUN=true                         # false für Live-Modus
LOG_LEVEL=INFO

# ─── Budget-Limits (EUR) ──────────────────────────────────────
DAILY_BUDGET_GOOGLE=20.0
DAILY_BUDGET_META=15.0
TARGET_CPA_LEAD=2.50
TARGET_CPA_SALE=18.00
