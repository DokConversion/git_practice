# ============================================================
# UC Business System — Umgebungsvariablen
# ============================================================
# 1. Kopiere diese Datei: cp .env.example .env
# 2. Trage deine echten API-Keys ein
# 3. NIEMALS .env in Git einchecken!
# ============================================================

# ── Claude / Anthropic ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Ads ──────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=1234567890          # ohne Bindestriche
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890    # MCC-Konto (falls vorhanden)

# ── Meta / Facebook ─────────────────────────────────────────
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=act_1234567890
META_PIXEL_ID=1234567890
META_PAGE_ID=1234567890

# ── Email-Marketing ─────────────────────────────────────────
EMAIL_PROVIDER=activecampaign             # activecampaign | mailchimp | getresponse
EMAIL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_API_URL=https://DEINACCOUNT.api-us1.com   # Nur für ActiveCampaign
EMAIL_FROM_NAME=UC Insider
EMAIL_FROM_ADDRESS=hallo@uc-insider.de

# ── Produkt-Plattform ────────────────────────────────────────
PRODUCT_PLATFORM=digistore24              # digistore24 | elopage | teachable
PRODUCT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PRODUCT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Produkt-IDs auf deiner Plattform
PRODUCT_ID_LEADMAGNET=
PRODUCT_ID_ENTRY=
PRODUCT_ID_UPSELL=

# ── Tracking ─────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=xxxxxxxxxxxxxxxx

# ── Business-Konfiguration ───────────────────────────────────
WEBSITE_DOMAIN=uc-insider.de

# Tagesbudgets in EUR
DAILY_BUDGET_GOOGLE=20.0
DAILY_BUDGET_META=15.0

# Ziel-CPA in EUR
TARGET_CPA_LEAD=2.5
TARGET_CPA_SALE=18.0

# ── System ───────────────────────────────────────────────────
DRY_RUN=true     # Auf false setzen für echte API-Calls!
LOG_LEVEL=INFO
